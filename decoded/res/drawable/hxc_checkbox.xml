<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:gravity="center" android:drawable="@drawable/hxc_check_tick" />
        </layer-list>
    </item>
    <item android:state_checked="false">
        <layer-list>
            <item android:gravity="center" android:drawable="@drawable/hxc_uncheck" />
        </layer-list>
    </item>
</selector>